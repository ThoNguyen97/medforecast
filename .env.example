# --- Bắt buộc ---
# ĐỔI cả hai giá trị dưới trước khi triển khai (đây chỉ là chỗ điền).
# Sinh SECRET_KEY: python -c "import secrets;print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=doi-mat-khau-nay
SECRET_KEY=doi-khoa-nay
ENVIRONMENT=production
CORS_ORIGINS=http://localhost:5173

# --- Nguồn dữ liệu đồng bộ ---
PIPELINE_SOURCE=file

# Khi nối HIS thật (SQL Server):
# PIPELINE_SOURCE=sqlserver
# Driver 18 bật mã hóa mặc định; HIS nội bộ thường dùng chứng thư tự ký nên cần
# TrustServerCertificate=yes. Ảnh Docker phải có gói msodbcsql18 (xem backend/Dockerfile).
# PIPELINE_SQLSERVER_CONN=mssql+pyodbc://user:pass@his-host:1433/HIS?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
#
# Câu SQL đọc nguồn nằm ở backend/app/data_pipeline/sql/, chọn bằng 2 biến dưới.
#   case_mssql.sql / inventory_mssql.sql : đọc THẲNG HIS PROD (mặc định)
#   case_sta.sql   / inventory_sta.sql   : đọc DB STA qua hàm & view (khuyến nghị)
# PIPELINE_CASE_SQL_FILE=case_sta.sql
# PIPELINE_INVENTORY_SQL_FILE=inventory_sta.sql

# --- Tinh chỉnh đồng bộ (tùy chọn — đây là giá trị mặc định) ---
# Số tháng nạp lại mỗi lần đồng bộ, để bắt hồ sơ được chốt mã ICD muộn.
# PIPELINE_LOOKBACK_MONTHS=3
# Số dòng mỗi lô khi đọc từ HIS (tránh nạp cả lịch sử vào RAM).
# PIPELINE_SQL_CHUNKSIZE=50000
# Thời gian chờ tối đa cho một truy vấn HIS (giây).
# PIPELINE_SQL_TIMEOUT=60
# Lịch chạy đồng bộ nền của app/data_pipeline/scheduler.py
# PIPELINE_CRON=0 2 * * *
