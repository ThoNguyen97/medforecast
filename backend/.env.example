# Cấu hình backend cho MÁY CÁ NHÂN (dev). Chép thành `.env` rồi sửa nếu cần —
# `scripts/khoi_tao_moi.py` tự làm việc đó và sinh SECRET_KEY ngẫu nhiên.
#
# File `.env` thật KHÔNG được commit (chứa mật khẩu HIS). Bản triển khai Docker
# dùng `.env.example` ở gốc repo, khác file này.

# ── Cơ sở dữ liệu ────────────────────────────────────────────────────────────
# Đường dẫn tương đối tính từ thư mục backend/ (nơi chạy uvicorn).
# MỌI bảng — nghiệp vụ lẫn tầng dữ liệu mart/fact — nằm chung một file này.
DATABASE_URL=sqlite:///./data/medforecast.db

# ── Bảo mật ──────────────────────────────────────────────────────────────────
# Sinh khoá mới: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=doi-khoa-nay-truoc-khi-trien-khai
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Ứng dụng ─────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=False
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Kết nối HIS / STA (tuỳ chọn) ─────────────────────────────────────────────
# Không bắt buộc: có thể nhập trong giao diện Quản trị → Kết nối HIS (lưu vào DB,
# đổi không cần khởi động lại). Chỉ dùng các biến dưới khi chạy CLI/cron.
# PIPELINE_SOURCE=sqlserver
# Phải là URL SQLAlchemy (mã nguồn gọi create_engine trực tiếp — chuỗi DSN thô
# dạng "DRIVER={...};SERVER=..." sẽ bị từ chối). Mật khẩu chứa @ : / thì
# bọc odbc_connect như dòng thứ hai.
# PIPELINE_SQLSERVER_CONN=mssql+pyodbc://medforecast_app:<mat-khau>@<host>:1433/MEDFORECAST_DW?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes
# PIPELINE_SQLSERVER_CONN=mssql+pyodbc:///?odbc_connect=DRIVER%3D%7BODBC+Driver+17+for+SQL+Server%7D%3BSERVER%3D<host>%2C1433%3BDATABASE%3DMEDFORECAST_DW%3BUID%3Dmedforecast_app%3BPWD%3D<mat-khau>%3BTrustServerCertificate%3Dyes
# PIPELINE_LOOKBACK_MONTHS=3
