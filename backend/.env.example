# Mẫu cấu hình backend. Chép thành `.env` rồi sửa nếu cần;
# `scripts/khoi_tao_moi.py` tự tạo `.env` và sinh SECRET_KEY ngẫu nhiên.
#
# File `.env` không được commit (chứa mật khẩu kết nối CSDL trung gian).

# Cơ sở dữ liệu
# Đường dẫn tương đối tính từ thư mục backend/ (nơi chạy uvicorn).
# Mọi bảng (nghiệp vụ và tầng dữ liệu mart/fact) nằm chung một file này.
DATABASE_URL=sqlite:///./data/medforecast.db

# Bảo mật
# Sinh khoá mới: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=doi-khoa-nay-truoc-khi-trien-khai
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Ứng dụng
ENVIRONMENT=development
DEBUG=False
LOG_LEVEL=INFO
# SQL_ECHO=True in toàn bộ câu SQL ra log; chỉ bật khi cần soi một truy vấn cụ
# thể, vì để lâu dài sẽ làm tệp log phình nhanh.
SQL_ECHO=False
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Kết nối CSDL trung gian (tuỳ chọn)
# Không bắt buộc: có thể nhập trong giao diện Quản trị > Nguồn dữ liệu (lưu vào CSDL,
# đổi không cần khởi động lại). Các biến dưới chỉ dùng khi chạy CLI/cron.
# PIPELINE_SOURCE=sqlserver
# Phải là URL SQLAlchemy (truyền thẳng vào create_engine; chuỗi DSN thô dạng
# "DRIVER={...};SERVER=..." bị từ chối). Mật khẩu chứa @ : / thì dùng dạng
# odbc_connect như dòng thứ hai.
# PIPELINE_SQLSERVER_CONN=mssql+pyodbc://medforecast_app:<mat-khau>@<host>:1433/MEDFORECAST_DW?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes
# PIPELINE_SQLSERVER_CONN=mssql+pyodbc:///?odbc_connect=DRIVER%3D%7BODBC+Driver+17+for+SQL+Server%7D%3BSERVER%3D<host>%2C1433%3BDATABASE%3DMEDFORECAST_DW%3BUID%3Dmedforecast_app%3BPWD%3D<mat-khau>%3BTrustServerCertificate%3Dyes
# PIPELINE_LOOKBACK_MONTHS=3
